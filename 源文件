// ==UserScript==
// @name         网页视频助手
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  类似华为浏览器的网页视频助手，提供悬浮四叶草按钮和播放设置功能
// @author       Assistant
// @match        *://*/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // 创建悬浮四叶草按钮
    function createFloatingButton() {
        const button = document.createElement('div');
        button.innerHTML = `
            <style>
                .video-assistant-btn {
                    position: fixed;
                    right: 20px;
                    bottom: 20px;
                    width: 50px;
                    height: 50px;
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                    z-index: 10000;
                    transition: all 0.3s ease;
                    opacity: 0;
                    transform: scale(0.8);
                }
                
                .video-assistant-btn:hover {
                    transform: scale(1.1);
                    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
                }
                
                .video-assistant-btn.show {
                    opacity: 1;
                    transform: scale(1);
                }
                
                .video-assistant-btn::before,
                .video-assistant-btn::after {
                    content: '';
                    position: absolute;
                    width: 20px;
                    height: 20px;
                    background: white;
                    border-radius: 50%;
                }
                
                .video-assistant-btn::before {
                    top: 10px;
                    left: 10px;
                }
                
                .video-assistant-btn::after {
                    bottom: 10px;
                    right: 10px;
                }
                
                .video-assistant-btn .center-dot {
                    width: 10px;
                    height: 10px;
                    background: white;
                    border-radius: 50%;
                    position: relative;
                    z-index: 2;
                }
                
                /* 设置面板样式 */
                .video-settings-panel {
                    position: fixed;
                    right: 80px;
                    bottom: 20px;
                    background: white;
                    border-radius: 10px;
                    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
                    padding: 20px;
                    z-index: 10001;
                    min-width: 200px;
                    display: none;
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                }
                
                .video-settings-panel.show {
                    display: block;
                    animation: slideIn 0.3s ease;
                }
                
                @keyframes slideIn {
                    from {
                        opacity: 0;
                        transform: translateX(20px);
                    }
                    to {
                        opacity: 1;
                        transform: translateX(0);
                    }
                }
                
                .settings-section {
                    margin-bottom: 15px;
                }
                
                .settings-section h3 {
                    margin: 0 0 10px 0;
                    font-size: 14px;
                    color: #333;
                    font-weight: 600;
                }
                
                .settings-buttons {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 5px;
                }
                
                .settings-btn {
                    padding: 6px 12px;
                    border: 1px solid #e1e5e9;
                    background: #f8f9fa;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 12px;
                    transition: all 0.2s ease;
                }
                
                .settings-btn:hover {
                    background: #e9ecef;
                    border-color: #adb5bd;
                }
                
                .settings-btn.active {
                    background: #007bff;
                    color: white;
                    border-color: #007bff;
                }
                
                .close-btn {
                    position: absolute;
                    top: 10px;
                    right: 10px;
                    background: none;
                    border: none;
                    font-size: 18px;
                    cursor: pointer;
                    color: #6c757d;
                }
                
                .close-btn:hover {
                    color: #495057;
                }
            </style>
            
            <div class="video-assistant-btn">
                <div class="center-dot"></div>
            </div>
            
            <div class="video-settings-panel">
                <button class="close-btn">&times;</button>
                <div class="settings-section">
                    <h3>全屏模式</h3>
                    <div class="settings-buttons">
                        <button class="settings-btn fullscreen-btn">全屏</button>
                    </div>
                </div>
                
                <div class="settings-section">
                    <h3>播放倍速</h3>
                    <div class="settings-buttons">
                        <button class="settings-btn speed-btn" data-speed="0.5">0.5x</button>
                        <button class="settings-btn speed-btn active" data-speed="1.0">1.0x</button>
                        <button class="settings-btn speed-btn" data-speed="1.25">1.25x</button>
                        <button class="settings-btn speed-btn" data-speed="1.5">1.5x</button>
                        <button class="settings-btn speed-btn" data-speed="1.75">1.75x</button>
                        <button class="settings-btn speed-btn" data-speed="2.0">2.0x</button>
                        <button class="settings-btn speed-btn" data-speed="2.25">2.25x</button>
                        <button class="settings-btn speed-btn" data-speed="2.5">2.5x</button>
                        <button class="settings-btn speed-btn" data-speed="3.0">3.0x</button>
                    </div>
                </div>
                
                <div class="settings-section">
                    <h3>画面尺寸</h3>
                    <div class="settings-buttons">
                        <button class="settings-btn size-btn active" data-size="original">原始</button>
                        <button class="settings-btn size-btn" data-size="fit">适应</button>
                        <button class="settings-btn size-btn" data-size="fill">填充</button>
                        <button class="settings-btn size-btn" data-size="stretch">拉伸</button>
                    </div>
                </div>
            </div>
        `;
        
        document.body.appendChild(button);
        return button;
    }

    // 获取当前页面中的视频元素（增强兼容性）
    function getVideoElements() {
        let videos = document.querySelectorAll('video');
        
        // 如果当前页面没有视频，检查iframe中的视频
        if (videos.length === 0) {
            const iframes = document.querySelectorAll('iframe');
            iframes.forEach(iframe => {
                try {
                    // 尝试访问iframe内的视频元素
                    const iframeVideos = iframe.contentDocument?.querySelectorAll('video');
                    if (iframeVideos && iframeVideos.length > 0) {
                        videos = Array.from(videos).concat(Array.from(iframeVideos));
                    }
                } catch (e) {
                    // 跨域限制，无法访问iframe内容
                    console.log('无法访问iframe内容:', e);
                }
            });
        }
        
        // 尝试检测YouTube视频
        if (videos.length === 0 && window.location.hostname.includes('youtube.com')) {
            const youtubeVideo = document.querySelector('#movie_player video') || 
                                document.querySelector('.html5-video-player video');
            if (youtubeVideo) {
                videos = [youtubeVideo];
            }
        }
        
        return videos;
    }

    // 显示悬浮按钮
    function showFloatingButton() {
        const btn = document.querySelector('.video-assistant-btn');
        if (btn) {
            btn.classList.add('show');
        }
    }

    // 隐藏悬浮按钮
    function hideFloatingButton() {
        const btn = document.querySelector('.video-assistant-btn');
        if (btn) {
            btn.classList.remove('show');
        }
    }

    // 切换设置面板显示
    function toggleSettingsPanel() {
        const panel = document.querySelector('.video-settings-panel');
        if (panel) {
            panel.classList.toggle('show');
        }
    }

    // 设置播放速度
    function setPlaybackSpeed(speed) {
        const videos = getVideoElements();
        videos.forEach(video => {
            video.playbackRate = parseFloat(speed);
        });
        
        // 更新按钮状态
        document.querySelectorAll('.speed-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.getAttribute('data-speed') === speed.toString()) {
                btn.classList.add('active');
            }
        });
    }

    // 设置画面尺寸
    function setVideoSize(size) {
        const videos = getVideoElements();
        videos.forEach(video => {
            // 重置所有样式
            video.style.objectFit = '';
            video.style.width = '';
            video.style.height = '';
            video.style.maxWidth = '';
            video.style.maxHeight = '';
            
            switch(size) {
                case 'original':
                    // 原始尺寸
                    video.style.objectFit = 'contain';
                    break;
                case 'fit':
                    // 适应屏幕
                    video.style.objectFit = 'contain';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    break;
                case 'fill':
                    // 填充屏幕（保持比例）
                    video.style.objectFit = 'cover';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    break;
                case 'stretch':
                    // 拉伸填充（不保持比例）
                    video.style.objectFit = 'fill';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    break;
            }
        });
        
        // 更新按钮状态
        document.querySelectorAll('.size-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.getAttribute('data-size') === size) {
                btn.classList.add('active');
            }
        });
    }

    // 切换全屏模式
    function toggleFullscreen() {
        const videos = getVideoElements();
        if (videos.length === 0) return;
        
        const video = videos[0];
        
        if (!document.fullscreenElement) {
            // 进入全屏
            if (video.requestFullscreen) {
                video.requestFullscreen();
            } else if (video.webkitRequestFullscreen) {
                video.webkitRequestFullscreen();
            } else if (video.mozRequestFullScreen) {
                video.mozRequestFullScreen();
            } else if (video.msRequestFullscreen) {
                video.msRequestFullscreen();
            }
        } else {
            // 退出全屏
            if (document.exitFullscreen) {
                document.exitFullscreen();
            } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
            } else if (document.mozCancelFullScreen) {
                document.mozCancelFullScreen();
            } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
            }
        }
    }

    // 初始化事件监听
    function initEventListeners() {
        // 悬浮按钮点击事件
        document.addEventListener('click', function(e) {
            if (e.target.closest('.video-assistant-btn')) {
                toggleSettingsPanel();
            }
            
            if (e.target.closest('.close-btn')) {
                const panel = document.querySelector('.video-settings-panel');
                if (panel) {
                    panel.classList.remove('show');
                }
            }
            
            // 倍速按钮点击
            if (e.target.classList.contains('speed-btn')) {
                const speed = e.target.getAttribute('data-speed');
                setPlaybackSpeed(speed);
            }
            
            // 尺寸按钮点击
            if (e.target.classList.contains('size-btn')) {
                const size = e.target.getAttribute('data-size');
                setVideoSize(size);
            }
            
            // 全屏按钮点击
            if (e.target.classList.contains('fullscreen-btn')) {
                toggleFullscreen();
            }
        });
        
        // 点击面板外部关闭面板
        document.addEventListener('click', function(e) {
            const panel = document.querySelector('.video-settings-panel');
            const btn = document.querySelector('.video-assistant-btn');
            
            if (panel && panel.classList.contains('show') && 
                !panel.contains(e.target) && 
                !btn.contains(e.target)) {
                panel.classList.remove('show');
            }
        });
        
        // 监听视频播放事件
        document.addEventListener('play', function(e) {
            if (e.target.tagName === 'VIDEO') {
                showFloatingButton();
            }
        }, true);
        
        // 监听视频暂停事件
        document.addEventListener('pause', function(e) {
            if (e.target.tagName === 'VIDEO') {
                // 延迟隐藏，避免频繁切换
                setTimeout(() => {
                    const videos = getVideoElements();
                    const anyPlaying = Array.from(videos).some(video => !video.paused);
                    if (!anyPlaying) {
                        hideFloatingButton();
                    }
                }, 2000);
            }
        }, true);
        
        // 监听页面卸载事件
        window.addEventListener('beforeunload', function() {
            hideFloatingButton();
        });
    }

    // 检测页面中的视频元素（定期检查，处理动态加载的视频）
    function detectVideos() {
        const videos = getVideoElements();
        if (videos.length > 0) {
            // 如果有视频元素，确保悬浮按钮可用
            const btn = document.querySelector('.video-assistant-btn');
            if (btn) {
                // 检查是否有视频正在播放
                const anyPlaying = Array.from(videos).some(video => !video.paused);
                if (anyPlaying) {
                    showFloatingButton();
                }
            }
        }
    }

    // 主初始化函数
    function init() {
        // 创建悬浮按钮
        createFloatingButton();
        
        // 初始化事件监听
        initEventListeners();
        
        // 定期检测视频元素（处理动态加载的视频）
        setInterval(detectVideos, 2000);
        
        console.log('网页视频助手已加载 - 支持所有HTML5视频格式');
    }

    // 等待DOM加载完成后初始化
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

})();
