                    cursor: pointer;
                    color: #6c757d;
                }
                
                .close-btn:hover {
                    color: #495057;
                }
            </style>
            
            <div class="video-assistant-btn">
                <div class="center-dot"></div>
            </div>
            
            <div class="video-settings-panel">
                <button class="close-btn">&times;</button>
                <div class="settings-section">
                    <h3>全屏模式</h3>
                    <div class="settings-buttons">
                        <button class="settings-btn fullscreen-btn">全屏</button>
                    </div>
                </div>
                
                <div class="settings-section">
                    <h3>播放倍速</h3>
                    <div class="settings-buttons">
                        <button class="settings-btn speed-btn" data-speed="0.5">0.5x</button>
                        <button class="settings-btn speed-btn active" data-speed="1.0">1.0x</button>
                        <button class="settings-btn speed-btn" data-speed="1.25">1.25x</button>
                        <button class="settings-btn speed-btn" data-speed="1.5">1.5x</button>
                        <button class="settings-btn speed-btn" data-speed="1.75">1.75x</button>
                        <button class="settings-btn speed-btn" data-speed="2.0">2.0x</button>
                        <button class="settings-btn speed-btn" data-speed="2.25">2.25x</button>
                        <button class="settings-btn speed-btn" data-speed="2.5">2.5x</button>
                        <button class="settings-btn speed-btn" data-speed="3.0">3.0x</button>
                    </div>
                </div>
                
                <div class="settings-section">
                    <h3>画面尺寸</h3>
                    <div class="settings-buttons">
                        <button class="settings-btn size-btn active" data-size="original">原始</button>
                        <button class="settings-btn size-btn" data-size="fit">适应</button>
                        <button class="settings-btn size-btn" data-size="fill">填充</button>
                        <button class="settings-btn size-btn" data-size="stretch">拉伸</button>
                    </div>
                </div>
            </div>
        `;
        
        document.body.appendChild(button);
        return button;
    }

    // 获取当前页面中的视频元素（增强移动端兼容性）
    function getVideoElements() {
        let videos = document.querySelectorAll('video');
        console.log(`找到 ${videos.length} 个标准视频元素`);
        
        // 移动端增强检测：检查更多可能的视频选择器
        if (videos.length === 0) {
            console.log('尝试移动端增强视频检测...');
            
            // 移动端常见的视频选择器
            const mobileSelectors = [
                'video',
                'video[src]',
                'video[data-src]',
                'video[poster]',
                '.video',
                '.video-player video',
                '.media-player video',
                '.player video',
                'video.video-js',
                'video.html5-video-player',
                'video.video-stream'
            ];
            
            mobileSelectors.forEach(selector => {
                try {
                    const foundVideos = document.querySelectorAll(selector);
                    if (foundVideos.length > 0) {
                        console.log(`通过选择器 "${selector}" 找到 ${foundVideos.length} 个视频元素`);
                        videos = Array.from(videos).concat(Array.from(foundVideos));
                    }
                } catch (e) {
                    console.log(`选择器 "${selector}" 查询失败:`, e);
                }
            });
        }
        
        // 如果当前页面没有视频，检查iframe中的视频
        if (videos.length === 0) {
            const iframes = document.querySelectorAll('iframe');
            console.log(`找到 ${iframes.length} 个iframe元素`);
            iframes.forEach(iframe => {
                try {
                    // 尝试访问iframe内的视频元素
                    const iframeVideos = iframe.contentDocument?.querySelectorAll('video');
                    if (iframeVideos && iframeVideos.length > 0) {
                        console.log(`在iframe中找到 ${iframeVideos.length} 个视频元素`);
                        videos = Array.from(videos).concat(Array.from(iframeVideos));
                    }
                } catch (e) {
                    // 跨域限制，无法访问iframe内容
                    console.log('无法访问iframe内容（跨域限制）:', e);
                }
            });
        }
        
        // 尝试检测YouTube视频（增强检测）
        if (videos.length === 0 && (window.location.hostname.includes('youtube.com') || 
                                   window.location.hostname.includes('youtu.be'))) {
            console.log('检测到YouTube网站，尝试查找YouTube视频元素');
            const youtubeVideo = document.querySelector('#movie_player video') || 
                                document.querySelector('.html5-video-player video') ||
                                document.querySelector('video.html5-main-video') ||
                                document.querySelector('video.video-stream');
            if (youtubeVideo) {
                console.log('找到YouTube视频元素:', youtubeVideo);
                videos = [youtubeVideo];
            } else {
                console.log('未找到YouTube视频元素');
            }
        }
        
        // 过滤掉不可用的视频元素（移动端放宽条件）
        videos = Array.from(videos).filter(video => {
            // 移动端放宽条件：只要存在video元素就认为是有效的
            const isValid = video && video.tagName === 'VIDEO';
            if (!isValid) {
                console.log('过滤掉无效视频元素:', video);
            } else {
                console.log('有效视频元素:', {
                    tagName: video.tagName,
                    readyState: video.readyState,
                    src: video.src,
                    currentSrc: video.currentSrc,
                    duration: video.duration
                });
            }
            return isValid;
        });
        
        console.log(`最终可用视频元素: ${videos.length}`);
        return videos;
    }

    // 显示悬浮按钮
    function showFloatingButton() {
        const btn = document.querySelector('.video-assistant-btn');
        if (btn) {
            btn.classList.add('show');
        }
    }

    // 隐藏悬浮按钮
    function hideFloatingButton() {
        const btn = document.querySelector('.video-assistant-btn');
        if (btn) {
            btn.classList.remove('show');
        }
    }

    // 切换设置面板显示
    function toggleSettingsPanel() {
        const panel = document.querySelector('.video-settings-panel');
        if (panel) {
            panel.classList.toggle('show');
        }
    }

    // 设置播放速度
    function setPlaybackSpeed(speed) {
        const videos = getVideoElements();
        videos.forEach(video => {
            video.playbackRate = parseFloat(speed);
        });
        
        // 更新按钮状态
        document.querySelectorAll('.speed-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.getAttribute('data-speed') === speed.toString()) {
                btn.classList.add('active');
            }
        });
    }

    // 设置画面尺寸
    function setVideoSize(size) {
        const videos = getVideoElements();
        videos.forEach(video => {
            // 重置所有样式
            video.style.objectFit = '';
            video.style.width = '';
            video.style.height = '';
            video.style.maxWidth = '';
            video.style.maxHeight = '';
            
            switch(size) {
                case 'original':
                    // 原始尺寸
                    video.style.objectFit = 'contain';
                    break;
                case 'fit':
                    // 适应屏幕
                    video.style.objectFit = 'contain';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    break;
                case 'fill':
                    // 填充屏幕（保持比例）
                    video.style.objectFit = 'cover';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    break;
                case 'stretch':
                    // 拉伸填充（不保持比例）
                    video.style.objectFit = 'fill';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    break;
            }
        });
        
        // 更新按钮状态
        document.querySelectorAll('.size-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.getAttribute('data-size') === size) {
                btn.classList.add('active');
            }
        });
    }

    // 切换全屏模式
    function toggleFullscreen() {
        const videos = getVideoElements();
        if (videos.length === 0) return;
        
        const video = videos[0];
        
        if (!document.fullscreenElement) {
            // 进入全屏
            if (video.requestFullscreen) {
                video.requestFullscreen();
            } else if (video.webkitRequestFullscreen) {
                video.webkitRequestFullscreen();
            } else if (video.mozRequestFullScreen) {
                video.mozRequestFullScreen();
            } else if (video.msRequestFullscreen) {
                video.msRequestFullscreen();
            }
        } else {
            // 退出全屏
            if (document.exitFullscreen) {
                document.exitFullscreen();
            } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
            } else if (document.mozCancelFullScreen) {
                document.mozCancelFullScreen();
            } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
            }
        }
    }

    // 初始化事件监听（适配移动端）
    function initEventListeners() {
        console.log('初始化事件监听器（移动端适配）...');
        console.log('用户代理:', navigator.userAgent);
        console.log('触摸支持:', 'ontouchstart' in window);
        
        // 移除可能重复的事件监听器
        document.removeEventListener('click', handleDocumentClick);
        document.removeEventListener('touchstart', handleDocumentTouch);
        
        // 处理触摸和点击事件
        function handleDocumentInteraction(e) {
            const target = e.target;
            console.log('交互事件:', e.type, target);
            
            if (target.closest('.video-assistant-btn')) {
                console.log('点击/触摸悬浮按钮');
                e.preventDefault();
                e.stopPropagation();
                toggleSettingsPanel();
                return;
            }
            
            if (target.closest('.close-btn')) {
                console.log('点击/触摸关闭按钮');
                e.preventDefault();
                e.stopPropagation();
                const panel = document.querySelector('.video-settings-panel');
                if (panel) {
                    panel.classList.remove('show');
                }
                return;
            }
            
            // 倍速按钮点击/触摸
            if (target.classList.contains('speed-btn')) {
                const speed = target.getAttribute('data-speed');
                console.log('设置播放速度:', speed);
                e.preventDefault();
                e.stopPropagation();
                setPlaybackSpeed(speed);
                return;
            }
            
            // 尺寸按钮点击/触摸
            if (target.classList.contains('size-btn')) {
                const size = target.getAttribute('data-size');
                console.log('设置画面尺寸:', size);
                e.preventDefault();
                e.stopPropagation();
                setVideoSize(size);
                return;
            }
            
            // 全屏按钮点击/触摸
            if (target.classList.contains('fullscreen-btn')) {
                console.log('切换全屏模式');
                e.preventDefault();
                e.stopPropagation();
                toggleFullscreen();
                return;
            }
            
            // 点击/触摸面板外部关闭面板
            const panel = document.querySelector('.video-settings-panel');
            const btn = document.querySelector('.video-assistant-btn');
            
            if (panel && panel.classList.contains('show') && 
                !panel.contains(target) && 
                !(btn && btn.contains(target))) {
                console.log('点击/触摸面板外部，关闭面板');
                panel.classList.remove('show');
            }
        }
        
        // 点击事件处理
        function handleDocumentClick(e) {
            handleDocumentInteraction(e);
        }
        
        // 触摸事件处理（移动端）
        function handleDocumentTouch(e) {
            handleDocumentInteraction(e);
        }
        
        // 同时监听点击和触摸事件
        document.addEventListener('click', handleDocumentClick);
        document.addEventListener('touchstart', handleDocumentTouch, { passive: false });
        
        // 监听视频播放事件（增强兼容性）
        function handleVideoPlay(e) {
            console.log('视频播放事件:', e.target);
            if (e.target.tagName === 'VIDEO') {
                showFloatingButton();
            }
        }
        
        function handleVideoPause(e) {
            console.log('视频暂停事件:', e.target);
            if (e.target.tagName === 'VIDEO') {
                // 延迟隐藏，避免频繁切换
                setTimeout(() => {
                    const videos = getVideoElements();
                    const anyPlaying = Array.from(videos).some(video => !video.paused);
                    console.log('检查是否有视频播放:', anyPlaying);
                    if (!anyPlaying) {
                        hideFloatingButton();
                    }
                }, 2000);
            }
        }
        
        // 为现有视频添加事件监听
        function addVideoEventListeners() {
            const videos = getVideoElements();
            videos.forEach(video => {
                video.removeEventListener('play', handleVideoPlay);
                video.removeEventListener('pause', handleVideoPause);
                video.addEventListener('play', handleVideoPlay);
                video.addEventListener('pause', handleVideoPause);
            });
        }
        
        // 初始添加事件监听
        addVideoEventListeners();
        
        // 定期为动态加载的视频添加事件监听
        setInterval(addVideoEventListeners, 3000);
        
        console.log('事件监听器初始化完成');
    }

    // 检测页面中的视频元素（移动端增强，定期检查，处理动态加载的视频）
    function detectVideos() {
        const videos = getVideoElements();
        console.log(`检测到 ${videos.length} 个视频元素`);
        
        // 移动端调试信息
        console.log('移动端调试信息:', {
            userAgent: navigator.userAgent,
            isMobile: /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent),
            touchSupport: 'ontouchstart' in window,
            screenSize: `${window.innerWidth}x${window.innerHeight}`,
            documentReadyState: document.readyState
        });
        
        if (videos.length > 0) {
            // 如果有视频元素，确保悬浮按钮可用
            const btn = document.querySelector('.video-assistant-btn');
            if (btn) {
                // 检查是否有视频正在播放
                const anyPlaying = Array.from(videos).some(video => !video.paused);
                console.log(`有视频正在播放: ${anyPlaying}`);
                
                // 移动端策略：只要有视频就显示按钮，无论是否播放
                const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                
                if (anyPlaying || isMobile) {
                    showFloatingButton();
                    console.log('显示悬浮按钮（移动端策略）');
                } else {
                    // 如果有视频但未播放，也显示按钮（方便用户操作）
                    const hasVideo = videos.length > 0;
                    if (hasVideo) {
                        showFloatingButton();
                        console.log('检测到视频，显示悬浮按钮');
                    } else {
                        hideFloatingButton();
                    }
                }
            } else {
                console.log('悬浮按钮未找到，重新创建...');
                createFloatingButton();
            }
        } else {
            console.log('未检测到视频元素');
            hideFloatingButton();
        }
    }

    // 主初始化函数
    function init() {
        console.log('网页视频助手开始初始化...');
        
        // 确保页面有body元素
        if (!document.body) {
            console.log('等待页面body加载...');
            setTimeout(init, 100);
            return;
        }
        
        // 创建悬浮按钮
        const button = createFloatingButton();
        if (button) {
            console.log('悬浮按钮创建成功');
            console.log('按钮位置：右下角 (right: 20px, bottom: 20px)');
            console.log('按钮初始状态：隐藏 (opacity: 0)，当视频播放时会显示');
        } else {
            console.error('悬浮按钮创建失败');
        }
        
        // 初始化事件监听
        initEventListeners();
        
        // 立即检测一次视频元素
        detectVideos();
        
        // 定期检测视频元素（处理动态加载的视频）
        setInterval(detectVideos, 2000);
        
        console.log('网页视频助手已加载 - 支持所有HTML5视频格式');
        console.log('调试信息：请打开浏览器控制台查看详细日志');
        console.log('测试步骤：');
        console.log('1. 打开包含视频的网页');
        console.log('2. 播放视频');
        console.log('3. 检查右下角是否出现四叶草按钮');
    }

    // 等待DOM加载完成后初始化
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

})();
