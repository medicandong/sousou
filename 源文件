    // 创建悬浮按钮
    function createFloatButton() {
        if (floatBtn || document.getElementById('video-assistant-float-btn')) return;

        floatBtn = document.createElement('div');
        floatBtn.id = 'video-assistant-float-btn';
        Object.assign(floatBtn.style, {
            position: 'fixed',
            right: '12px',
            bottom: '80px',
            width: '36px',
            height: '36px',
