                /* 设置面板样式 */
                .video-settings-panel {
                    position: fixed;
                    right: 80px;
                    bottom: 20px;
                    background: white;
                    border-radius: 10px;
                    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
                    padding: 20px;
                    z-index: 10001;
