            padding: '8px 0',
            color: 'white',
            fontSize: '14px',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
            backdropFilter: 'blur(12px)',
            opacity: '0',
            transform: 'translateY(10px)',
            pointerEvents: 'none',
            transition: 'all 0.25s ease'
        });

        const items = [
            { text: '全屏播放', action: enterSmartFullScreen },
            { text: '播放速度', id: 'speed-item', menu: () => showSpeedMenu(document.getElementById('speed-item')) },
            { text: '画面尺寸', id: 'size-item', menu: () => showSizeMenu(document.getElementById('size-item')) }
        ];

        items.forEach((item, i) => {
            const div = document.createElement('div');
            div.style.cssText = 'padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; cursor: pointer;';
            if (item.id) div.id = item.id;

            if (item.action) {
                div.innerHTML = `<span>${item.text}</span>`;
                div.onclick = (e) => { e.stopPropagation(); item.action(); closePanel(); };
            } else {
                div.innerHTML = `<span>${item.text}</span><span id="val-${i}">1.0x</span>`;
                div.onclick = (e) => { e.stopPropagation(); item.menu(); };
            }

            // 悬停效果
            div.onmouseover = () => div.style.background = 'rgba(255,255,255,0.1)';
            div.onmouseout = () => div.style.background = '';

            controlPanel.appendChild(div);
        });

        document.documentElement.appendChild(controlPanel);
    }

    // 智能全屏
    function enterSmartFullScreen() {
        if (!currentVideo) return;

        const video = currentVideo;
        const w = video.videoWidth, h = video.videoHeight;

        const goFull = () => {
            if (video.requestFullscreen) video.requestFullscreen();
            else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen();
            else if (video.webkitRequestFullscreen) video.webkitRequestFullscreen();

            setTimeout(showFullScreenBar, 600);
            isFullScreen = true;
        };

        if (w && h && screen.orientation?.lock) {
            const isLandscape = w > h;
            screen.orientation.lock(isLandscape ? 'landscape' : 'portrait').catch(() => {});
        }

        goFull();
    }

    // 创建全屏控制条
    function createFullScreenBar() {
        if (fullScreenBar) return;

        fullScreenBar = document.createElement('div');
        fullScreenBar.id = 'video-fullscreen-bar';
        Object.assign(fullScreenBar.style, {
            position: 'fixed',
            bottom: '0',
            left: '0',
            right: '0',
            height: '56px',
            background: 'linear-gradient(transparent, rgba(0,0,0,0.8))',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-around',
            zIndex: '2147483645',
            color: 'white',
            fontSize: '14px',
            backdropFilter: 'blur(10px)',
            opacity: '0',
            transition: 'opacity 0.3s',
            padding: '0 12px',
            boxSizing: 'border-box'
        });

        // 进度条
        const progressWrap = document.createElement('div');
        progressWrap.style.cssText = 'flex: 1; height: 3px; background: rgba(255,255,255,0.3); border-radius: 2px; overflow: hidden; margin: 0 12px;';
        const progress = document.createElement('div');
        progress.id = 'fs-progress';
        progress.style.cssText = 'height: 100%; width: 0%; background: #00bfa5;';
        progressWrap.appendChild(progress);
        fullScreenBar.appendChild(progressWrap);

        // 倍速
        const speedBtn = document.createElement('div');
        speedBtn.id = 'fs-speed';
        speedBtn.textContent = '1.0x';
        speedBtn.style.cssText = 'padding: 6px 12px; background: rgba(255,255,255,0.15); border-radius: 8px; min-width: 50px; text-align: center; font-weight: 500;';
        speedBtn.onclick = (e) => { e.stopPropagation(); showSpeedMenu(speedBtn, true); };
        fullScreenBar.appendChild(speedBtn);

        // 尺寸
        const sizeBtn = document.createElement('div');
        sizeBtn.id = 'fs-size';
        sizeBtn.textContent = '原始';
        sizeBtn.style.cssText = 'padding: 6px 12px; background: rgba(255,255,255,0.15); border-radius: 8px; min-width: 50px; text-align: center; font-weight: 500;';
        sizeBtn.onclick = (e) => { e.stopPropagation(); showSizeMenu(sizeBtn, true); };
        fullScreenBar.appendChild(sizeBtn);

        document.documentElement.appendChild(fullScreenBar);

        // 自动隐藏
        let hideTimer;
        const show = () => {
            clearTimeout(hideTimer);
            fullScreenBar.style.opacity = '1';
            hideTimer = setTimeout(() => fullScreenBar.style.opacity = '0', 3000);
        };
        fullScreenBar.addEventListener('touchstart', show);
        show();

        // 进度更新
        setInterval(() => {
            if (currentVideo && !currentVideo.paused && !currentVideo.ended) {
                const p = (currentVideo.currentTime / currentVideo.duration) * 100;
                progress.style.width = p + '%';
            }
        }, 500);
    }

    function showFullScreenBar() {
        createFullScreenBar();
        updateSpeedDisplay();
        updateSizeDisplay();
    }

