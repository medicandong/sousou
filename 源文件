                }
                
                .video-assistant-btn.show {
                    opacity: 1;
                    transform: scale(1);
                }
                
                /* 移动端触摸优化 */
                .video-assistant-btn:active {
                    transform: scale(0.95);
                }
                
                .video-assistant-btn::before,
                .video-assistant-btn::after {
                    content: '';
                    position: absolute;
                    width: 20px;
                    height: 20px;
                    background: white;
                    border-radius: 50%;
                }
                
                .video-assistant-btn::before {
                    top: 10px;
                    left: 10px;
                }
                
                .video-assistant-btn::after {
                    bottom: 10px;
                    right: 10px;
                }
                
                .video-assistant-btn .center-dot {
                    width: 10px;
                    height: 10px;
                    background: white;
                    border-radius: 50%;
                    position: relative;
                    z-index: 2;
