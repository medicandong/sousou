                }
                
                .settings-section h3 {
                    margin: 0 0 10px 0;
                    font-size: 14px;
                    color: #333;
                    font-weight: 600;
                }
                
                .settings-buttons {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 5px;
                }
                
                .settings-btn {
                    padding: 6px 12px;
                    border: 1px solid #e1e5e9;
                    background: #f8f9fa;
                    border-radius: 6px;
                    cursor: pointer;
                    font-size: 12px;
                    transition: all 0.2s ease;
                }
                
                .settings-btn:hover {
                    background: #e9ecef;
                    border-color: #adb5bd;
                }
                
                .settings-btn.active {
                    background: #007bff;
                    color: white;
                    border-color: #007bff;
